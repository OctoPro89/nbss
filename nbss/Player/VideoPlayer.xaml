<Window x:Class="nbss.Player.VideoPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nbss.Player"
        mc:Ignorable="d"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="NBSS Video Player" Height="450" Width="800" Style="{StaticResource QuartzWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <vlc:VideoView Background="{StaticResource Editor.Window.GrayBrush1}" x:Name="videoView" Grid.Row="0" />

        <TextBlock x:Name="loadingText" Text="Loading..."
               FontSize="24" FontWeight="Bold" Style="{StaticResource LightTextBlockStyle}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Visible"/>

        <Grid x:Name="controlsPanel" MouseEnter="ControlsPanel_MouseEnter" MouseLeave="ControlsPanel_MouseLeave" Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Play" x:Name="playButton" Click="Play_Click" Margin="5" Grid.Column="0"/>

            <Slider x:Name="SeekBar" Margin="5"
                Minimum="0" Maximum="100"
                ValueChanged="SeekBar_ValueChanged"
                PreviewMouseDown="SeekBar_PreviewMouseDown"
                PreviewMouseUp="SeekBar_PreviewMouseUp"
                Grid.Column="1"
                VerticalAlignment="Center"/>

            <TextBlock x:Name="TimeDisplay" Foreground="White" Margin="5" 
                   VerticalAlignment="Center" Text="0:00/0:00" FontSize="14" Grid.Column="2"/>

            <ComboBox x:Name="audioTracksCombo" Width="150" Margin="5" SelectionChanged="AudioTracksCombo_SelectionChanged" Grid.Column="3"/>
            <ComboBox x:Name="subtitleTracksCombo" Width="150" Margin="5" SelectionChanged="SubtitleTracksCombo_SelectionChanged" Grid.Column="4"/>
            <Button Content="⛶" Width="30" Click="FullscreenButton_Click" Margin="5" Grid.Column="5"/>
            <CheckBox Style="{StaticResource QuartzButtonStyle}" x:Name="subsCheckbox" Content="Subs" IsChecked="True" Checked="SubsCheckbox_Checked" Unchecked="SubsCheckbox_Unchecked" Margin="5" Grid.Column="6"/>
        </Grid>
    </Grid>
</Window>
