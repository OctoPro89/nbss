<Window x:Class="nbss.CreateTorrentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:nbss"
             mc:Ignorable="d" Style="{StaticResource QuartzDialogStyle}"
             ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
             Title="Create torrent" Height="500" Width="500">
    <Border CornerRadius="5" Background="{StaticResource Editor.Window.GrayBrush3}" HorizontalAlignment="Stretch"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Opacity="0.6" BlurRadius="15" ShadowDepth="2"/>
        </Border.Effect>
        <Grid Margin="32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource Editor.RedBrush}" FontSize="10"
                           Margin="0,10,0,0" TextWrapping="Wrap" x:Name="messageTextBlock"/>
            </ScrollViewer>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                       Text="Torrent File URL and Magnet: Specify ONE FIELD: a remote .torrent URL OR a Magnet link."
                       Style="{StaticResource LightTextBlockStyle}" TextWrapping="Wrap"></TextBlock>
                <TextBlock Grid.Row="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                       Text="Name: Specify a custom name for a torrent, optional."
                       Style="{StaticResource LightTextBlockStyle}" TextWrapping="Wrap"></TextBlock>
                <TextBlock Grid.Row="3" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                        Text="Seed is your seeding preferece (1 is auto, 2 is seed, 3 is don't seed)."
                        Style="{StaticResource LightTextBlockStyle}" TextWrapping="Wrap"></TextBlock>
                <TextBlock Grid.Row="1" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                       Text="Allow Zip: true if you are okay with Torbox zipping large torrents."
                       Style="{StaticResource LightTextBlockStyle}" TextWrapping="Wrap"></TextBlock>
                <TextBlock Grid.Row="4" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                        Text="As Queued specifies if you want the torrent to be instantly queued."
                        Style="{StaticResource LightTextBlockStyle}" TextWrapping="Wrap"></TextBlock>
            </Grid>

            <DockPanel Grid.Row="2" Margin="10">
                <TextBlock Text="Torrent File URL" Width="90" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox x:Name="urlTextBox" IsEnabled="False"/>
            </DockPanel>
            <DockPanel Grid.Row="3" Margin="10">
                <TextBlock Text="Magnet" Width="90" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox x:Name="magnetTextBox"/>
            </DockPanel>

            <DockPanel Grid.Row="4" Margin="10">
                <TextBlock Text="Name" Width="90" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox x:Name="nameTextBox"/>
            </DockPanel>

            <DockPanel Grid.Row="5" Margin="10">
                <TextBlock Text="Seed" Width="90" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox x:Name="seedTextBox" Text="1"/>
            </DockPanel>

            <Grid Grid.Row="6" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="5" Style="{StaticResource QuartzButtonStyle}" x:Name="allowZipCheck" Content="Allow Zip"/>
                    <CheckBox Margin="5" Style="{StaticResource QuartzButtonStyle}" x:Name="asQueuedCheck" Content="As Queued"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Bottom"
                        HorizontalAlignment="Right" Margin="0,0,0,20">
                <TextBlock Style="{StaticResource LightTextBlockStyle}" x:Name="outputText"></TextBlock>
                <Button Content="Ok" Width="64" Margin="32,0" IsDefault="True" Click="OnOk_Button_Click"/>
                <Button Content="Cancel" Width="64" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
