<UserControl x:Class="nbss.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:nbss"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBlock Style="{StaticResource LightTextBlockStyle}"
           Margin="20,20,0,0" HorizontalAlignment="Center"
           VerticalAlignment="Top" FontSize="25" FontWeight="Bold">nbss dashboard v1.0</TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Click="OnGetMylistButton_Click" Margin="10,0,10,0" Content="Get My list" Style="{StaticResource QuartzButtonStyle}"></Button>
                    <Button Click="OnCreateTorrentButton_Click" Margin="10,0,10,0" Content="Create Torrent" Style="{StaticResource QuartzButtonStyle}"></Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Grid.Row="1">
                <TextBlock x:Name="resultText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LightTextBlockStyle}" Text=""></TextBlock>
            </Grid>

            <Grid Grid.Column="0" Grid.Row="2">
                <ListBox ItemsSource="{Binding Torrents}"
                         x:Name="torrentsListBox" SelectionChanged="OnTorrentsListBox_SelectionChanged"
                         SelectedItem="{Binding SelectedTorrent, Mode=TwoWay}"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource LightTextBlockStyle}" TextTrimming="WordEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!-- Files list -->
                <ListBox x:Name="filesListBox"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock FontSize="12" Foreground="{StaticResource Editor.FontBrush}" Margin="20,0,20,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="torrentViewName"
                               Text="Click on a torrent to view info" TextWrapping="Wrap"></TextBlock>

                <!-- File info & download button -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                
                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <TextBlock Style="{StaticResource LightTextBlockStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding SelectedFile.Name}" FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock Style="{StaticResource LightTextBlockStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding SelectedFile.Size, StringFormat='Size: {0:N0} bytes'}" />
                    </StackPanel>

                    <!-- Download status display -->
                    <TextBlock Grid.Row="1" Margin="10,0,10,10" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="LightGreen" TextWrapping="Wrap" Text="{Binding DownloadStatus}"/>

                    <!-- Buttons panel -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Button Content="Get File Download Link" Grid.Column="0" Grid.Row="0"
                Click="OnGetDownloadLink_Click" HorizontalAlignment="Left"
                Margin="10,5,0,0" Width="150">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource QuartzButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Stream" Grid.Column="1" Grid.Row="0"
                Click="OnStreamButton_Click" HorizontalAlignment="Right"
                Margin="60,5,0,0" Width="150">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource QuartzButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Get Torrent Link" Grid.Column="0" Grid.Row="1"
                                    Click="OnGetTorrentDownloadLink_Click" HorizontalAlignment="Center"
                                    Margin="10,5,0,0" Width="150">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource QuartzButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTorrent}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTorrent.DownloadFinished}" Value="false">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Delete Torrent" Grid.Column="1" Grid.Row="1"
                                    Click="DeleteTorrent_Click" HorizontalAlignment="Center"
                                    Margin="60,5,0,0" Width="150">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource QuartzButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTorrent}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTorrent.DownloadFinished}" Value="false">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
